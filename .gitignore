target/*
!target/criterion/
!target/criterion/**

helper/

data/*
!data/raw/
data/raw/*
!data/raw/_Samples/
!data/raw/_Samples/**

# Generated reports (diag traces, bench summaries, ...) are ignored at
# any depth; `.gitkeep` files keep the subdirectory structure (e.g.
# reports/diag/, reports/benches/) present in a fresh clone. Un-ignoring
# a directory is required before its contents can be un-ignored too, so
# this is three rules, not one.
reports/**
!reports/**/
!reports/**/.gitkeep