\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit  {dedup}$ removes byte-identical patterns and inputs; $\mathit  {strip}(p,[\texttt  {\textasciicircum },\texttt  {\textdollar }])$ produces the translated \texttt  {Regex} $r$. The check keeps each input only if $\mathit  {parse}(r,w)$ agrees with its label (\text  {$\mathsurround \z@ \mathchar "458$}), validating the pattern's semantics rather than real-world correctness. Thus, \texttt  {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries.}}{57}{figure.caption.61}\protected@file@percent }
\newlabel{fig:s2elab-pipeline}{{8.1}{57}{The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit {dedup}$ removes byte-identical patterns and inputs; $\mathit {strip}(p,[\texttt {\textasciicircum },\texttt {\textdollar }])$ produces the translated \texttt {Regex} $r$. The check keeps each input only if $\mathit {parse}(r,w)$ agrees with its label (\checkmark ), validating the pattern's semantics rather than real-world correctness. Thus, \texttt {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries}{figure.caption.61}{}}
