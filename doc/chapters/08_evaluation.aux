\@writefile{lot}{\contentsline {table}{\numberline {8.32}{\ignorespaces Heap allocation over the default scope of 463 patterns and 11\,395 entries. \emph  {Total allocated} counts all allocations, including freed memory, and measures allocator pressure. \emph  {Avg/entry} divides this total by the number of entries each parser completes, accounting for differences in completed work. \emph  {Max live peak} is the highest live-byte count within a single call and measures peak memory footprint. Total and peak differ because total includes freed memory. Crashed entries are excluded from all three (Table~\ref {tab:corpus-timing}); no entry times out. \texttt  {deriv\_std\_rec} is omitted (Section~\ref {sec:eval-criteria-timing}); its figures track \texttt  {deriv\_std}'s closely (206.71\,GB, 19.09\,MB, 9\,281.8\,MB).}}{76}{table.caption.96}\protected@file@percent }
\newlabel{tab:memory}{{8.32}{76}{Heap allocation over the default scope of 463 patterns and 11\,395 entries. \emph {Total allocated} counts all allocations, including freed memory, and measures allocator pressure. \emph {Avg/entry} divides this total by the number of entries each parser completes, accounting for differences in completed work. \emph {Max live peak} is the highest live-byte count within a single call and measures peak memory footprint. Total and peak differ because total includes freed memory. Crashed entries are excluded from all three (Table~\ref {tab:corpus-timing}); no entry times out. \texttt {deriv\_std\_rec} is omitted (Section~\ref {sec:eval-criteria-timing}); its figures track \texttt {deriv\_std}'s closely (206.71\,GB, 19.09\,MB, 9\,281.8\,MB)}{table.caption.96}{}}
