\newlabel{tab:corpus-timing}{{8.14}{64}{Corpus timing over the default scope of 463 patterns and 11\,395 entries per parser, 11\,377 measured for \texttt {deriv\_std\_loop} (the rest crash, Section~\ref {sec:eval-criteria-setup}; \texttt {deriv\_std\_rec} crashes on the same entries, Section~\ref {sec:eval-stack-depth}) and all 11\,395 for the other three; no entry ever times out}{table.caption.70}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.15}{\ignorespaces Total wall time by verified outcome on the same run as Table~\ref {tab:corpus-timing}. None of the 11\,395 entries ever times out; \texttt  {deriv\_std\_loop}'s 18 crashes split 17 on the match side and 1 on the non-match side (\texttt  {deriv\_std\_rec} crashes on the same entries, Section~\ref {sec:eval-stack-depth}).}}{64}{table.caption.71}\protected@file@percent }
\newlabel{tab:corpus-timing-outcome}{{8.15}{64}{Total wall time by verified outcome on the same run as Table~\ref {tab:corpus-timing}. None of the 11\,395 entries ever times out; \texttt {deriv\_std\_loop}'s 18 crashes split 17 on the match side and 1 on the non-match side (\texttt {deriv\_std\_rec} crashes on the same entries, Section~\ref {sec:eval-stack-depth})}{table.caption.71}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.16}{\ignorespaces Four-phase timing breakdown (ms) over the same corpus scope as Table~\ref {tab:corpus-timing}, median per phase, pooled per entry. \texttt  {deriv\_std\_loop}'s own \emph  {Reconstruct} is its backward injection pass; at the median it costs almost nothing, same as the other three candidates. Each row's \emph  {Total} is the entry's own median total time rather than the sum of the per-phase medians beside it, since medians do not add the way means do. \texttt  {deriv\_std\_rec} is omitted (Section~\ref {sec:eval-criteria-timing}).}}{64}{table.caption.72}\protected@file@percent }
\newlabel{tab:corpus-timing-phases}{{8.16}{64}{Four-phase timing breakdown (ms) over the same corpus scope as Table~\ref {tab:corpus-timing}, median per phase, pooled per entry. \texttt {deriv\_std\_loop}'s own \emph {Reconstruct} is its backward injection pass; at the median it costs almost nothing, same as the other three candidates. Each row's \emph {Total} is the entry's own median total time rather than the sum of the per-phase medians beside it, since medians do not add the way means do. \texttt {deriv\_std\_rec} is omitted (Section~\ref {sec:eval-criteria-timing})}{table.caption.72}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.17}{\ignorespaces The five costliest S2ELab entries by \texttt  {pderiv\_bc}'s own wall time, found with \texttt  {demo\_peak\_offenders} (\texttt  {reports/benches/bench\_corpus\_C1\_entries.csv}, metric \texttt  {micros}), cross-referenced against the other three parsers on the identical entry. \texttt  {deriv\_std\_loop} crashes on four of the five; on the fifth it is roughly $300\times $ slower than any other candidate rather than crashing, the one entry among these five where it completes at all.}}{65}{table.caption.73}\protected@file@percent }
\newlabel{tab:corpus-worst-offenders}{{8.17}{65}{The five costliest S2ELab entries by \texttt {pderiv\_bc}'s own wall time, found with \texttt {demo\_peak\_offenders} (\texttt {reports/benches/bench\_corpus\_C1\_entries.csv}, metric \texttt {micros}), cross-referenced against the other three parsers on the identical entry. \texttt {deriv\_std\_loop} crashes on four of the five; on the fifth it is roughly $300\times $ slower than any other candidate rather than crashing, the one entry among these five where it completes at all}{table.caption.73}{}}
