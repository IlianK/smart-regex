\@writefile{lot}{\contentsline {table}{\numberline {8.7}{\ignorespaces Dataset composition. \emph  {Pattern~$n$} and \emph  {Input~$n$} are each corpus as authored; A \emph  {Rejected} pattern uses an unsupported construct or feature (Table~\ref {tab:surface-rejected}); An \emph  {Accepted} pattern has the shape of a fully anchored pattern, only using explictily supported constructs (Table~\ref {tab:surface-syntax}). 7 S2ELab patterns are duplicates and were removed before classification. Together, accepted, rejected, and duplicate patterns account for the original \emph  {Pattern~$n$}. Of the 18\,930 original inputs, 11\,395 belong to the 463 accepted patterns.}}{59}{table.caption.63}\protected@file@percent }
\newlabel{tab:dataset-summary}{{8.7}{59}{Dataset composition. \emph {Pattern~$n$} and \emph {Input~$n$} are each corpus as authored; A \emph {Rejected} pattern uses an unsupported construct or feature (Table~\ref {tab:surface-rejected}); An \emph {Accepted} pattern has the shape of a fully anchored pattern, only using explictily supported constructs (Table~\ref {tab:surface-syntax}). 7 S2ELab patterns are duplicates and were removed before classification. Together, accepted, rejected, and duplicate patterns account for the original \emph {Pattern~$n$}. Of the 18\,930 original inputs, 11\,395 belong to the 463 accepted patterns}{table.caption.63}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3.1}S2ELab}{59}{subsection.8.3.1}\protected@file@percent }
\newlabel{sec:eval-s2elab}{{8.3.1}{59}{S2ELab}{subsection.8.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit  {dedup}$ removes byte-identical patterns and inputs; $\mathit  {strip}(p,[\texttt  {\textasciicircum },\texttt  {\textdollar }])$ produces the translated \texttt  {Regex} $r$. The check keeps each input only if $\mathit  {parse}(r,w)$ agrees with its label (\text  {$\mathsurround \z@ \mathchar "458$}), validating the pattern's semantics rather than real-world correctness. Thus, \texttt  {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries.}}{59}{figure.caption.64}\protected@file@percent }
\newlabel{fig:s2elab-pipeline}{{8.1}{59}{The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit {dedup}$ removes byte-identical patterns and inputs; $\mathit {strip}(p,[\texttt {\textasciicircum },\texttt {\textdollar }])$ produces the translated \texttt {Regex} $r$. The check keeps each input only if $\mathit {parse}(r,w)$ agrees with its label (\checkmark ), validating the pattern's semantics rather than real-world correctness. Thus, \texttt {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries}{figure.caption.64}{}}
