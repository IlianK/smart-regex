\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces Wall time at the pattern and scale of \citet  {sulzmannlu2014}'s Figure~7, every swept $n$ plotted (log-log). \texttt  {deriv\_bc} is directly comparable to \texttt  {parseBC} (their Figures~5 and~6); the narrower \texttt  {DERIV} implementation the paper actually plots solves an easier, submatching-only problem, and \texttt  {pderiv\_bc}/\texttt  {pderiv\_std} are this project's own partial-derivative constructions, not benchmarked by either paper. Wall time is the match-side entry's own reported \texttt  {micros}; the non-match side is within a few percent throughout and omitted. \texttt  {deriv\_std\_rec} and \texttt  {deriv\_std\_loop} have no curve to plot: Table~\ref {tab:patho-crash-thresholds} locates exactly where each crashes on these two rows.}}{70}{figure.caption.55}\protected@file@percent }
\newlabel{fig:patho-fig7}{{8.2}{70}{Wall time at the pattern and scale of \citet {sulzmannlu2014}'s Figure~7, every swept $n$ plotted (log-log). \texttt {deriv\_bc} is directly comparable to \texttt {parseBC} (their Figures~5 and~6); the narrower \texttt {DERIV} implementation the paper actually plots solves an easier, submatching-only problem, and \texttt {pderiv\_bc}/\texttt {pderiv\_std} are this project's own partial-derivative constructions, not benchmarked by either paper. Wall time is the match-side entry's own reported \texttt {micros}; the non-match side is within a few percent throughout and omitted. \texttt {deriv\_std\_rec} and \texttt {deriv\_std\_loop} have no curve to plot: Table~\ref {tab:patho-crash-thresholds} locates exactly where each crashes on these two rows}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Wall time on P20, every swept $n$ plotted (log-log). Same family as Figure~\ref {fig:patho-fig7}, the \texttt  {+} variant of the same pattern. \texttt  {deriv\_std\_rec}/\texttt  {deriv\_std\_loop} crash from $n=100$ on (Table~\ref {tab:patho-crash-thresholds}).}}{70}{figure.caption.56}\protected@file@percent }
\newlabel{fig:patho-p20}{{8.3}{70}{Wall time on P20, every swept $n$ plotted (log-log). Same family as Figure~\ref {fig:patho-fig7}, the \texttt {+} variant of the same pattern. \texttt {deriv\_std\_rec}/\texttt {deriv\_std\_loop} crash from $n=100$ on (Table~\ref {tab:patho-crash-thresholds})}{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces Wall time on P01 and P09, every swept $n$ plotted (log-log). \texttt  {deriv\_bc} is the one parser that eventually times out on P01 too (visible as its line stopping at $n=50{,}000$, short of the partial-derivative pair's); on P09 all three survive the whole sweep. \texttt  {deriv\_std\_rec}/\texttt  {deriv\_std\_loop} crash from $n=50$ (P01) and $n=100$ (P09) on.}}{71}{figure.caption.57}\protected@file@percent }
\newlabel{fig:patho-p01-p09}{{8.4}{71}{Wall time on P01 and P09, every swept $n$ plotted (log-log). \texttt {deriv\_bc} is the one parser that eventually times out on P01 too (visible as its line stopping at $n=50{,}000$, short of the partial-derivative pair's); on P09 all three survive the whole sweep. \texttt {deriv\_std\_rec}/\texttt {deriv\_std\_loop} crash from $n=50$ (P01) and $n=100$ (P09) on}{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.5}{\ignorespaces Wall time on P25/P27/P28, every swept $n$ plotted (log-log). All three share \texttt  {deriv\_bc} eventually timing out (its line stops at $n=10{,}000$ on every row, short of the partial-derivative pair's); P27 and P28 additionally show \texttt  {deriv\_std\_rec}/ \texttt  {deriv\_std\_loop} crashing already at $n=15$ (Table~\ref {tab:patho-crash-thresholds}), far earlier than P25's $n=3{,}500$.}}{72}{figure.caption.58}\protected@file@percent }
\newlabel{fig:patho-f}{{8.5}{72}{Wall time on P25/P27/P28, every swept $n$ plotted (log-log). All three share \texttt {deriv\_bc} eventually timing out (its line stops at $n=10{,}000$ on every row, short of the partial-derivative pair's); P27 and P28 additionally show \texttt {deriv\_std\_rec}/ \texttt {deriv\_std\_loop} crashing already at $n=15$ (Table~\ref {tab:patho-crash-thresholds}), far earlier than P25's $n=3{,}500$}{figure.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.9}{\ignorespaces Match-side crash/timeout thresholds. The standard columns cover both \texttt  {deriv\_std\_rec} and \texttt  {deriv\_std\_loop} together, since they crash at the identical swept $n$ on every one of these eight rows. ``---'' means \texttt  {deriv\_bc} completed every swept $n$ for that row without timing out.}}{73}{table.caption.59}\protected@file@percent }
