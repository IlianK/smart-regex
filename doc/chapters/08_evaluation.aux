\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces Wall time on P60, \texttt  {(a|b|ab)*} against \texttt  {a} repeated, every swept $n$ plotted on a log-log axis. \texttt  {deriv\_bc} is directly comparable to the reference implementation's bit-coded parser. The two standard derivative parsers have no curve because both crash before the first plotted point.}}{74}{figure.caption.55}\protected@file@percent }
\newlabel{fig:patho-fig7a}{{8.1}{74}{Wall time on P60, \texttt {(a|b|ab)*} against \texttt {a} repeated, every swept $n$ plotted on a log-log axis. \texttt {deriv\_bc} is directly comparable to the reference implementation's bit-coded parser. The two standard derivative parsers have no curve because both crash before the first plotted point}{figure.caption.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.9}{\ignorespaces Match-side crash and timeout thresholds. The standard columns cover both \texttt  {deriv\_std\_rec} and \texttt  {deriv\_std\_loop}, since both crash at the identical swept $n$ on every row. A dash means \texttt  {deriv\_bc} completed every swept $n$ without timing out.}}{74}{table.caption.56}\protected@file@percent }
\newlabel{tab:patho-crash-thresholds}{{8.9}{74}{Match-side crash and timeout thresholds. The standard columns cover both \texttt {deriv\_std\_rec} and \texttt {deriv\_std\_loop}, since both crash at the identical swept $n$ on every row. A dash means \texttt {deriv\_bc} completed every swept $n$ without timing out}{table.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces Wall time on P61 and P20, every swept $n$ on a log-log axis. On P61 the two partial-derivative variants flip rank relative to P60, with \texttt  {pderiv\_bc} now faster throughout. On P20 \texttt  {pderiv\_bc} is also lower-peak than \texttt  {pderiv\_std}.}}{75}{figure.caption.57}\protected@file@percent }
\newlabel{fig:patho-fig7bc}{{8.2}{75}{Wall time on P61 and P20, every swept $n$ on a log-log axis. On P61 the two partial-derivative variants flip rank relative to P60, with \texttt {pderiv\_bc} now faster throughout. On P20 \texttt {pderiv\_bc} is also lower-peak than \texttt {pderiv\_std}}{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Wall time on P01 and P09, every swept $n$ on a log-log axis. \texttt  {deriv\_bc} is the one parser that eventually times out on P01, at $n=200\,000$, short of the partial-derivative pair's full sweep. On P09 all three survivors complete the whole sweep. The two standard variants crash from $n=50$ on P01 and from $n=100$ on P09.}}{76}{figure.caption.58}\protected@file@percent }
\newlabel{fig:patho-p01-p09}{{8.3}{76}{Wall time on P01 and P09, every swept $n$ on a log-log axis. \texttt {deriv\_bc} is the one parser that eventually times out on P01, at $n=200\,000$, short of the partial-derivative pair's full sweep. On P09 all three survivors complete the whole sweep. The two standard variants crash from $n=50$ on P01 and from $n=100$ on P09}{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces Wall time on P25, P27 and P28, every swept $n$ on a log-log axis. \texttt  {deriv\_bc} eventually times out on all three, its line stopping at $n=10\,000$. P27 and P28 additionally show the two standard variants crashing already at $n=15$, far earlier than P25's $n=3\,500$.}}{77}{figure.caption.59}\protected@file@percent }
\newlabel{fig:patho-f}{{8.4}{77}{Wall time on P25, P27 and P28, every swept $n$ on a log-log axis. \texttt {deriv\_bc} eventually times out on all three, its line stopping at $n=10\,000$. P27 and P28 additionally show the two standard variants crashing already at $n=15$, far earlier than P25's $n=3\,500$}{figure.caption.59}{}}
