\@writefile{lot}{\contentsline {table}{\numberline {8.25}{\ignorespaces Heap allocation over the default scope of 463 patterns and 11\,395 entries. \emph  {Total allocated} counts all allocations, including freed memory, and measures allocator pressure. \emph  {Avg/entry} divides this total by the number of entries each parser completes, accounting for differences in completed work. \emph  {Max live peak} is the highest live-byte count within a single call and measures peak memory footprint. Total and peak differ because total includes freed memory. Crashed entries are excluded from all three (Table~\ref {tab:corpus-timing}); no entry times out.}}{81}{table.caption.88}\protected@file@percent }
\newlabel{tab:memory}{{8.25}{81}{Heap allocation over the default scope of 463 patterns and 11\,395 entries. \emph {Total allocated} counts all allocations, including freed memory, and measures allocator pressure. \emph {Avg/entry} divides this total by the number of entries each parser completes, accounting for differences in completed work. \emph {Max live peak} is the highest live-byte count within a single call and measures peak memory footprint. Total and peak differ because total includes freed memory. Crashed entries are excluded from all three (Table~\ref {tab:corpus-timing}); no entry times out}{table.caption.88}{}}
