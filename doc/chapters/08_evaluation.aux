\@writefile{lot}{\contentsline {table}{\numberline {8.11}{\ignorespaces E37: \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}. An \texttt  {E}-row sweeping the pattern's alternation width $p$ at fixed input length (\texttt  {(?:aaaa|aaab|}\dots  \texttt  {)}, $p$ distinct four-letter alternatives; input \texttt  {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt  {pderiv\_bc}, whose plain tree clone does less work per node than \texttt  {deriv\_bc}'s annotated-state construction. Decode stays under 0.5\,ms throughout for both. Derive dominates and diverges sharply: \texttt  {pderiv\_bc} is 2.9$\times $ \texttt  {deriv\_bc}'s derive time at $p=100$, 14.7$\times $ by $p=2\,000$, and 37.3$\times $ by $p=10\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt  {deriv\_bc} does not enumerate them individually.}}{79}{table.caption.62}\protected@file@percent }
\newlabel{tab:patho-phases-e37}{{8.11}{79}{E37: \texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}. An \texttt {E}-row sweeping the pattern's alternation width $p$ at fixed input length (\texttt {(?:aaaa|aaab|}\dots \texttt {)}, $p$ distinct four-letter alternatives; input \texttt {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt {pderiv\_bc}, whose plain tree clone does less work per node than \texttt {deriv\_bc}'s annotated-state construction. Decode stays under 0.5\,ms throughout for both. Derive dominates and diverges sharply: \texttt {pderiv\_bc} is 2.9$\times $ \texttt {deriv\_bc}'s derive time at $p=100$, 14.7$\times $ by $p=2\,000$, and 37.3$\times $ by $p=10\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt {deriv\_bc} does not enumerate them individually}{table.caption.62}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.12}{\ignorespaces E38: \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}. An \texttt  {E}-row, sweeping a $p$-way alternation of distinct numbered words (\texttt  {w000001}, \dots  , \texttt  {w0000}$p$), at fixed input length. The matching input is a single word (the first alternative). Derive grows with $p$ for both parsers, but the divergence between them is milder and flatter than on E37: \texttt  {pderiv\_bc}'s derive time is 2.6$\times $ \texttt  {deriv\_bc}'s at $p=100$, climbing only to 7.0$\times $ by $p=10\,000$, against E37's 2.9$\times $ to 37.3$\times $ over the same range. Encode remains cheaper for \texttt  {pderiv\_bc} throughout, as on E37, and decode stays under 0.8\,ms for both even at the widest point.}}{79}{table.caption.63}\protected@file@percent }
\newlabel{tab:patho-phases-e38}{{8.12}{79}{E38: \texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}. An \texttt {E}-row, sweeping a $p$-way alternation of distinct numbered words (\texttt {w000001}, \dots , \texttt {w0000}$p$), at fixed input length. The matching input is a single word (the first alternative). Derive grows with $p$ for both parsers, but the divergence between them is milder and flatter than on E37: \texttt {pderiv\_bc}'s derive time is 2.6$\times $ \texttt {deriv\_bc}'s at $p=100$, climbing only to 7.0$\times $ by $p=10\,000$, against E37's 2.9$\times $ to 37.3$\times $ over the same range. Encode remains cheaper for \texttt {pderiv\_bc} throughout, as on E37, and decode stays under 0.8\,ms for both even at the widest point}{table.caption.63}{}}
