\newlabel{fig:patho-p09}{{8.5}{79}{Wall time on P09, \texttt {(a|aa)+} against \texttt {a} repeated, every swept $n$ on a log-log axis. The lower panel plots the partial-derivative pair's time as a ratio to \texttt {deriv\_bc}}{figure.caption.61}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.11}{\ignorespaces \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}, E37: an \texttt  {E}-row sweeping the pattern's alternation width $p$ at fixed input length (E37: \texttt  {(?:aaaa|aaab|}\dots  \texttt  {)}, $p$ distinct four-letter alternatives; input \texttt  {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt  {pderiv\_bc}, whose plain tree clone does less work per node than \texttt  {deriv\_bc}'s annotated-state construction. Decode stays under 0.1\,ms throughout for both. Derive dominates and diverges sharply: \texttt  {pderiv\_bc} is 3.3$\times $ \texttt  {deriv\_bc}'s derive time at $p=100$ but 15.8$\times $ at $p=2\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt  {deriv\_bc}'s symbolic derivative does not enumerate them individually. On the non-matching input \texttt  {"zzzz"} (not shown), which fails on the first character, both parsers stay under 3.5\,ms even at $p=2\,000$ -- the divergence above is specific to inputs that keep many alternatives alive.}}{80}{table.caption.62}\protected@file@percent }
\newlabel{tab:patho-phases-e37}{{8.11}{80}{\texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}, E37: an \texttt {E}-row sweeping the pattern's alternation width $p$ at fixed input length (E37: \texttt {(?:aaaa|aaab|}\dots \texttt {)}, $p$ distinct four-letter alternatives; input \texttt {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt {pderiv\_bc}, whose plain tree clone does less work per node than \texttt {deriv\_bc}'s annotated-state construction. Decode stays under 0.1\,ms throughout for both. Derive dominates and diverges sharply: \texttt {pderiv\_bc} is 3.3$\times $ \texttt {deriv\_bc}'s derive time at $p=100$ but 15.8$\times $ at $p=2\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt {deriv\_bc}'s symbolic derivative does not enumerate them individually. On the non-matching input \texttt {"zzzz"} (not shown), which fails on the first character, both parsers stay under 3.5\,ms even at $p=2\,000$ -- the divergence above is specific to inputs that keep many alternatives alive}{table.caption.62}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.12}{\ignorespaces \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}, E38: a sibling \texttt  {E}-row to Table~\ref {tab:patho-phases-e37}, sweeping a $p$-way alternation of distinct numbered words (\texttt  {w000001}, \dots  , \texttt  {w0000}$p$) with no repetition operator, at fixed input length. The matching input is a single word (the first alternative); the non-matching input concatenates the first two words, so every parser must scan past the first alternative before rejecting -- unlike E37's \texttt  {"zzzz"}, which fails immediately. E38 reaches $p=1\,000$ cleanly but hits \texttt  {core\_regex\_tagged}'s translation-size cap at $p=2\,000$, where E37 does not; the two rows are compared only up to $p=1\,000$ for this reason. Derive again dominates and grows with $p$ for both parsers, but the divergence between them is milder than on E37: \texttt  {pderiv\_bc}'s derive time is 2.2$\times $ \texttt  {deriv\_bc}'s at $p=100$ and 4.1$\times $ at $p=1\,000$, against E37's 3.3$\times $ and 10.2$\times $ at the same two points. Encode remains cheaper for \texttt  {pderiv\_bc} throughout, as on E37, and decode again stays under 0.1\,ms for both.}}{81}{table.caption.63}\protected@file@percent }
\newlabel{tab:patho-phases-e38}{{8.12}{81}{\texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}, E38: a sibling \texttt {E}-row to Table~\ref {tab:patho-phases-e37}, sweeping a $p$-way alternation of distinct numbered words (\texttt {w000001}, \dots , \texttt {w0000}$p$) with no repetition operator, at fixed input length. The matching input is a single word (the first alternative); the non-matching input concatenates the first two words, so every parser must scan past the first alternative before rejecting -- unlike E37's \texttt {"zzzz"}, which fails immediately. E38 reaches $p=1\,000$ cleanly but hits \texttt {core\_regex\_tagged}'s translation-size cap at $p=2\,000$, where E37 does not; the two rows are compared only up to $p=1\,000$ for this reason. Derive again dominates and grows with $p$ for both parsers, but the divergence between them is milder than on E37: \texttt {pderiv\_bc}'s derive time is 2.2$\times $ \texttt {deriv\_bc}'s at $p=100$ and 4.1$\times $ at $p=1\,000$, against E37's 3.3$\times $ and 10.2$\times $ at the same two points. Encode remains cheaper for \texttt {pderiv\_bc} throughout, as on E37, and decode again stays under 0.1\,ms for both}{table.caption.63}{}}
