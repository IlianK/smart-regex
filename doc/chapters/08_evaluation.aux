\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces Wall time on P60, \texttt  {(a|b|ab)*} against \texttt  {a} repeated, to the scale of \citet  {sulzmannlu2014}'s Figure~7(a). The lower panel plots the partial-derivative pair as a ratio to \texttt  {deriv\_bc}.}}{77}{figure.caption.58}\protected@file@percent }
\newlabel{fig:patho-fig7a}{{8.2}{77}{Wall time on P60, \texttt {(a|b|ab)*} against \texttt {a} repeated, to the scale of \citet {sulzmannlu2014}'s Figure~7(a). The lower panel plots the partial-derivative pair as a ratio to \texttt {deriv\_bc}}{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Wall time on P61 (category E, prefix-overlap alternation), \texttt  {(a|b|ab)*} against \texttt  {ab} repeated, every swept $n$ on a log-log axis. This row reproduces the reference paper's Figure~7(b) at the same multi-million-character scale used for P60, isolating whether an \texttt  {ab}-repeated input instead of \texttt  {a}-repeated changes the ranking among the three survivors: here \texttt  {pderiv\_bc} is faster throughout, flipping its rank relative to P60.}}{78}{figure.caption.59}\protected@file@percent }
\newlabel{fig:patho-fig7bc}{{8.3}{78}{Wall time on P61 (category E, prefix-overlap alternation), \texttt {(a|b|ab)*} against \texttt {ab} repeated, every swept $n$ on a log-log axis. This row reproduces the reference paper's Figure~7(b) at the same multi-million-character scale used for P60, isolating whether an \texttt {ab}-repeated input instead of \texttt {a}-repeated changes the ranking among the three survivors: here \texttt {pderiv\_bc} is faster throughout, flipping its rank relative to P60}{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces Wall time on P01 (category A, nested quantifiers) and P09 (category B, overlapping alternation), every swept $n$ on a log-log axis. The two rows isolate nesting from overlap: P01's \texttt  {(a+)+} nests a quantifier inside another, while P09's \texttt  {(a|aa)+} instead overlaps two alternatives without nesting. \texttt  {deriv\_bc} is the one parser that eventually times out, and only on P01, at $n=200\,000$, short of the partial-derivative pair's full sweep; on P09 all three survivors complete the whole sweep. The two standard variants crash from $n=50$ on P01 and from $n=100$ on P09.}}{79}{figure.caption.60}\protected@file@percent }
\newlabel{fig:patho-p01-p09}{{8.4}{79}{Wall time on P01 (category A, nested quantifiers) and P09 (category B, overlapping alternation), every swept $n$ on a log-log axis. The two rows isolate nesting from overlap: P01's \texttt {(a+)+} nests a quantifier inside another, while P09's \texttt {(a|aa)+} instead overlaps two alternatives without nesting. \texttt {deriv\_bc} is the one parser that eventually times out, and only on P01, at $n=200\,000$, short of the partial-derivative pair's full sweep; on P09 all three survivors complete the whole sweep. The two standard variants crash from $n=50$ on P01 and from $n=100$ on P09}{figure.caption.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.5}{\ignorespaces Wall time on P25, P27, and P28 (all category F, alternation-star-then-literal), every swept $n$ on a log-log axis. The three share the same \texttt  {(\ldots  )*c} shape at increasing nesting depth -- P25 flat, P27 nesting a plus, P28 nesting a star -- chosen to isolate nesting depth as the stress axis while holding the alternation and the trailing literal fixed. \texttt  {deriv\_bc} eventually times out on all three, its line stopping at $n=10\,000$. P27 and P28 additionally show the two standard variants crashing already at $n=15$, far earlier than P25's $n=3\,500$.}}{80}{figure.caption.61}\protected@file@percent }
\newlabel{fig:patho-f}{{8.5}{80}{Wall time on P25, P27, and P28 (all category F, alternation-star-then-literal), every swept $n$ on a log-log axis. The three share the same \texttt {(\ldots )*c} shape at increasing nesting depth -- P25 flat, P27 nesting a plus, P28 nesting a star -- chosen to isolate nesting depth as the stress axis while holding the alternation and the trailing literal fixed. \texttt {deriv\_bc} eventually times out on all three, its line stopping at $n=10\,000$. P27 and P28 additionally show the two standard variants crashing already at $n=15$, far earlier than P25's $n=3\,500$}{figure.caption.61}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.11}{\ignorespaces \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}, E37: an \texttt  {E}-row sweeping the pattern's alternation width $p$ at fixed input length (E37: \texttt  {(?:aaaa|aaab|}\dots  \texttt  {)}, $p$ distinct four-letter alternatives; input \texttt  {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt  {pderiv\_bc}, whose plain tree clone does less work per node than \texttt  {deriv\_bc}'s annotated-state construction. Decode stays under 0.1\,ms throughout for both. Derive dominates and diverges sharply: \texttt  {pderiv\_bc} is 3.3$\times $ \texttt  {deriv\_bc}'s derive time at $p=100$ but 15.8$\times $ at $p=2\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt  {deriv\_bc}'s symbolic derivative does not enumerate them individually. On the non-matching input \texttt  {"zzzz"} (not shown), which fails on the first character, both parsers stay under 3.5\,ms even at $p=2\,000$ -- the divergence above is specific to inputs that keep many alternatives alive.}}{81}{table.caption.62}\protected@file@percent }
\newlabel{tab:patho-phases-e37}{{8.11}{81}{\texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}, E37: an \texttt {E}-row sweeping the pattern's alternation width $p$ at fixed input length (E37: \texttt {(?:aaaa|aaab|}\dots \texttt {)}, $p$ distinct four-letter alternatives; input \texttt {"aaaa"}, matching the first alternative immediately). Encode grows only mildly with $p$ for both parsers, and is consistently cheaper for \texttt {pderiv\_bc}, whose plain tree clone does less work per node than \texttt {deriv\_bc}'s annotated-state construction. Decode stays under 0.1\,ms throughout for both. Derive dominates and diverges sharply: \texttt {pderiv\_bc} is 3.3$\times $ \texttt {deriv\_bc}'s derive time at $p=100$ but 15.8$\times $ at $p=2\,000$, since a partial-derivative step touches every live alternative on each character, while \texttt {deriv\_bc}'s symbolic derivative does not enumerate them individually. On the non-matching input \texttt {"zzzz"} (not shown), which fails on the first character, both parsers stay under 3.5\,ms even at $p=2\,000$ -- the divergence above is specific to inputs that keep many alternatives alive}{table.caption.62}{}}
