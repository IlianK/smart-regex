\@writefile{lot}{\contentsline {table}{\numberline {8.8}{\ignorespaces Dataset composition. \emph  {Pattern~$n$} and \emph  {Input~$n$} are each corpus as authored, before any filtering; S2ELab's own given matches and non-matches are both counted. A \emph  {Rejected} pattern uses an unsupported construct; an \emph  {Accepted} pattern is only one in the shape of a fully anchored pattern. The remaining 7 S2ELab patterns are byte-identical duplicates, dropped before classification. Of the 463 accepted patterns, 11\,395 of the 18\,930 original inputs survive deduplication.}}{61}{table.caption.63}\protected@file@percent }
\newlabel{tab:dataset-summary}{{8.8}{61}{Dataset composition. \emph {Pattern~$n$} and \emph {Input~$n$} are each corpus as authored, before any filtering; S2ELab's own given matches and non-matches are both counted. A \emph {Rejected} pattern uses an unsupported construct; an \emph {Accepted} pattern is only one in the shape of a fully anchored pattern. The remaining 7 S2ELab patterns are byte-identical duplicates, dropped before classification. Of the 463 accepted patterns, 11\,395 of the 18\,930 original inputs survive deduplication}{table.caption.63}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3.1}S2ELab}{61}{subsection.8.3.1}\protected@file@percent }
\newlabel{sec:eval-s2elab}{{8.3.1}{61}{S2ELab}{subsection.8.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit  {dedup}$ removes byte-identical patterns and inputs; $\mathit  {strip}(p,[\texttt  {\textasciicircum },\texttt  {\textdollar }])$ produces the translated \texttt  {Regex} $r$. The check keeps each input only if $\mathit  {parse}(r,w)$ agrees with its label (\text  {$\mathsurround \z@ \mathchar "458$}), validating the pattern's semantics rather than real-world correctness. Thus, \texttt  {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries.}}{61}{figure.caption.64}\protected@file@percent }
\newlabel{fig:s2elab-pipeline}{{8.1}{61}{The S2ELab preparation pipeline. Extraction keeps the pattern $p$ with match list $[w_1]$ and non-match list $[w_2]$; $\mathit {dedup}$ removes byte-identical patterns and inputs; $\mathit {strip}(p,[\texttt {\textasciicircum },\texttt {\textdollar }])$ produces the translated \texttt {Regex} $r$. The check keeps each input only if $\mathit {parse}(r,w)$ agrees with its label (\checkmark ), validating the pattern's semantics rather than real-world correctness. Thus, \texttt {"55/5/3434"} is accepted because the pattern checks digit counts, not value ranges. The surviving triples $(r,w,e)$ are the defined entries}{figure.caption.64}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.9}{\ignorespaces S2ELab patterns rejected, broken down by cause. \emph  {Substring Search} covers every pattern not in the fully anchored \texttt  {\textasciicircum \ldots  \textdollar } shape this evaluation requires, whether because it has no anchor at all or an anchor placed elsewhere; the remaining causes are rejected by the frontend for an unsupported construct.}}{62}{table.caption.65}\protected@file@percent }
\newlabel{tab:corpus-rejection-causes}{{8.9}{62}{S2ELab patterns rejected, broken down by cause. \emph {Substring Search} covers every pattern not in the fully anchored \texttt {\textasciicircum \ldots \textdollar } shape this evaluation requires, whether because it has no anchor at all or an anchor placed elsewhere; the remaining causes are rejected by the frontend for an unsupported construct}{table.caption.65}{}}
