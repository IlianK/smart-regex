\@writefile{lot}{\contentsline {table}{\numberline {8.28}{\ignorespaces Peak live memory across the two E-family representative rows, against the largest swept input length each parser completed. Peak is the live high-water mark within a single call. The standard variants complete only the smallest swept inputs, so their peak is not directly comparable with the survivors' peaks and is excluded from the comparison in the text. On P61, \texttt  {pderiv\_std} newly crashes against the 8\,GiB memory cap at the widest swept length on the matching input (it still completes there on the non-matching one); the length and peak shown are from the largest matching input it still completes, $5\,000\,000$, matching Table~\ref {tab:patho-crash-thresholds}'s own threshold for it.}}{72}{table.caption.87}\protected@file@percent }
\newlabel{tab:patho-memory-e}{{8.28}{72}{Peak live memory across the two E-family representative rows, against the largest swept input length each parser completed. Peak is the live high-water mark within a single call. The standard variants complete only the smallest swept inputs, so their peak is not directly comparable with the survivors' peaks and is excluded from the comparison in the text. On P61, \texttt {pderiv\_std} newly crashes against the 8\,GiB memory cap at the widest swept length on the matching input (it still completes there on the non-matching one); the length and peak shown are from the largest matching input it still completes, $5\,000\,000$, matching Table~\ref {tab:patho-crash-thresholds}'s own threshold for it}{table.caption.87}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.29}{\ignorespaces Peak live memory across the two nested-quantifier representative rows, against the largest swept input length each parser completed. \emph  {Max live peak} is the live high-water mark within a single call.}}{72}{table.caption.88}\protected@file@percent }
\newlabel{tab:patho-memory-ab}{{8.29}{72}{Peak live memory across the two nested-quantifier representative rows, against the largest swept input length each parser completed. \emph {Max live peak} is the live high-water mark within a single call}{table.caption.88}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.30}{\ignorespaces E37 memory: \texttt  {deriv\_bc} vs.\ \texttt  {pderiv\_bc}, same $p$ sweep as Table~\ref {tab:patho-phases-e37}. \emph  {Avg/entry} is the mean total allocation of the matching and non-matching entries at each $p$; \emph  {Max peak} is the larger of their two live high-water marks. Memory favours \texttt  {pderiv\_bc} at small $p$ but crosses over between $p=1\,000$ and $p=2\,000$, the opposite of the timing picture: by $p=10\,000$ \texttt  {deriv\_bc} is the cheaper of the two, roughly $5\times $ lower than \texttt  {pderiv\_bc} on both columns (25.04 against 131.57\,MB average; 11.72 against 55.77\,MB peak).}}{73}{table.caption.89}\protected@file@percent }
\newlabel{tab:patho-mem-e37}{{8.30}{73}{E37 memory: \texttt {deriv\_bc} vs.\ \texttt {pderiv\_bc}, same $p$ sweep as Table~\ref {tab:patho-phases-e37}. \emph {Avg/entry} is the mean total allocation of the matching and non-matching entries at each $p$; \emph {Max peak} is the larger of their two live high-water marks. Memory favours \texttt {pderiv\_bc} at small $p$ but crosses over between $p=1\,000$ and $p=2\,000$, the opposite of the timing picture: by $p=10\,000$ \texttt {deriv\_bc} is the cheaper of the two, roughly $5\times $ lower than \texttt {pderiv\_bc} on both columns (25.04 against 131.57\,MB average; 11.72 against 55.77\,MB peak)}{table.caption.89}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.31}{\ignorespaces E38 memory, same $p$ sweep as Table~\ref {tab:patho-phases-e38} and same columns as Table~\ref {tab:patho-mem-e37}. The crossover comes later than on E37, between $p=2\,000$ and $p=5\,000$, and the final gap is narrower: \texttt  {deriv\_bc} ends up roughly $2.9\times $ cheaper than \texttt  {pderiv\_bc} at $p=10\,000$ (78.76 against 226.70\,MB average; 18.44 against 60.09\,MB peak), against E37's $5\times $.}}{73}{table.caption.90}\protected@file@percent }
\newlabel{tab:patho-mem-e38}{{8.31}{73}{E38 memory, same $p$ sweep as Table~\ref {tab:patho-phases-e38} and same columns as Table~\ref {tab:patho-mem-e37}. The crossover comes later than on E37, between $p=2\,000$ and $p=5\,000$, and the final gap is narrower: \texttt {deriv\_bc} ends up roughly $2.9\times $ cheaper than \texttt {pderiv\_bc} at $p=10\,000$ (78.76 against 226.70\,MB average; 18.44 against 60.09\,MB peak), against E37's $5\times $}{table.caption.90}{}}
