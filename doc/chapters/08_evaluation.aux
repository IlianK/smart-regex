\@writefile{lot}{\contentsline {table}{\numberline {8.4}{\ignorespaces Parser agreement, measured once per dataset and never pooled. S2ELab: 6624 matching / 6624 non-matching cases, 6527 of 6544 compared cases built the same tree across families (17 \emph  {Diff}). Pathological: category breakdown in Table~\ref {tab:agreement-patho}; 182 of 202 compared cases agree (one category, B, accounts for 18 of the 21 \emph  {Diff}). The single pathological crash is \texttt  {deriv\_std\_rec} stack-overflowing on a 10-million-character input in category I --- the same failure mode as Section~\ref {sec:eval-timing-pathological}'s FIG7A/FIG7B finding, confirmed here on a trivial pattern, so it is a property of input length alone, not of \texttt  {(a|b|ab)*}'s specific ambiguity.}}{75}{table.caption.46}\protected@file@percent }
\newlabel{tab:agreement}{{8.4}{75}{Parser agreement, measured once per dataset and never pooled. S2ELab: 6624 matching / 6624 non-matching cases, 6527 of 6544 compared cases built the same tree across families (17 \emph {Diff}). Pathological: category breakdown in Table~\ref {tab:agreement-patho}; 182 of 202 compared cases agree (one category, B, accounts for 18 of the 21 \emph {Diff}). The single pathological crash is \texttt {deriv\_std\_rec} stack-overflowing on a 10-million-character input in category I --- the same failure mode as Section~\ref {sec:eval-timing-pathological}'s FIG7A/FIG7B finding, confirmed here on a trivial pattern, so it is a property of input length alone, not of \texttt {(a|b|ab)*}'s specific ambiguity}{table.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.5}{\ignorespaces Pathological-set agreement by category (one crashed entry, category I, omitted from this breakdown's totals; see Table~\ref {tab:agreement}). Category H's numbers are post-fix (see Section~\ref {sec:eval-timing-pathological}'s discussion of \texttt  {P29}/\texttt  {P31}).}}{75}{table.caption.47}\protected@file@percent }
\newlabel{tab:agreement-patho}{{8.5}{75}{Pathological-set agreement by category (one crashed entry, category I, omitted from this breakdown's totals; see Table~\ref {tab:agreement}). Category H's numbers are post-fix (see Section~\ref {sec:eval-timing-pathological}'s discussion of \texttt {P29}/\texttt {P31})}{table.caption.47}{}}
