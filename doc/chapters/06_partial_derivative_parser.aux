\newlabel{sec:pderiv-bc}{{6.2}{53}{The Bit-Coded Partial-Derivative Parser}{section.6.2}{}}
\newlabel{eq:pderiv-bc-overview}{{6.6}{53}{The Bit-Coded Partial-Derivative Parser}{equation.6.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt  {ab}$. Each box is a configuration: a residual expression and a bit-sequence, written $0$ for $\mathit  {false}$ and $1$ for $\mathit  {true}$. Selection takes the first accepting configuration in $S_2$ and appends $\mathit  {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit  {decode}_{r_0}$ reads against the original expression.}}{53}{figure.caption.33}\protected@file@percent }
\newlabel{fig:pderiv-bc-overview}{{6.6}{53}{Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt {ab}$. Each box is a configuration: a residual expression and a bit-sequence, written $0$ for $\mathit {false}$ and $1$ for $\mathit {true}$. Selection takes the first accepting configuration in $S_2$ and appends $\mathit {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit {decode}_{r_0}$ reads against the original expression}{figure.caption.33}{}}
