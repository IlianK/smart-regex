\newlabel{eq:pderiv-bc-overview}{{6.5}{45}{The Bit-Coded Partial-Derivative Parser}{equation.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.8}{\ignorespaces Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt  {ab}$. Each box is a pair: a residual expression and a bit-sequence, with $0$ marking a left branch or one more iteration and $1$ marking a right branch or termination. Selection takes the first accepting pair in $S_2$ and appends $\mathit  {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit  {decode}_{r_0}$ reads against the original expression.}}{46}{figure.caption.40}\protected@file@percent }
\newlabel{fig:pderiv-bc-overview}{{6.8}{46}{Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt {ab}$. Each box is a pair: a residual expression and a bit-sequence, with $0$ marking a left branch or one more iteration and $1$ marking a right branch or termination. Selection takes the first accepting pair in $S_2$ and appends $\mathit {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit {decode}_{r_0}$ reads against the original expression}{figure.caption.40}{}}
