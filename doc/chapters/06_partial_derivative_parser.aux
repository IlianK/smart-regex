\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Frontier size against distinct residual count for $(a+(b+ab))^{*}$ on $(\mathtt  {ab})^{n}$, logarithmic vertical scale. The frontier doubles every two characters while the number of distinct residuals never exceeds two: every strand beyond the second is a duplicate carrying different accumulated state. Regenerate with \texttt  {cargo run -{}-release -{}-example thesis\_figures -{}- frontier}; \texttt  {tests/test\_thesis\_figures.rs} pins these values.}}{68}{figure.6.3}\protected@file@percent }
\newlabel{fig:frontier-growth}{{6.3}{68}{Frontier size against distinct residual count for $(a+(b+ab))^{*}$ on $(\mathtt {ab})^{n}$, logarithmic vertical scale. The frontier doubles every two characters while the number of distinct residuals never exceeds two: every strand beyond the second is a duplicate carrying different accumulated state. Regenerate with \texttt {cargo run -{}-release -{}-example thesis\_figures -{}- frontier}; \texttt {tests/test\_thesis\_figures.rs} pins these values}{figure.6.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Deduplicating across the frontier.}{68}{figure.6.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6.6}The Two Policies Compared}{69}{section.6.6}\protected@file@percent }
\newlabel{sec:pderiv-worked-example}{{6.6}{69}{The Two Policies Compared}{section.6.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces The two parse trees for $(a+ab)(b+\varepsilon )$ against \texttt  {"ab"}. Both flatten to \texttt  {"ab"} and both are valid. The derivative parsers take the second alternative of $a+ab$, consuming both characters at once and leaving $b+\varepsilon $ to match empty; the partial-derivative parsers take the first, leaving $b+\varepsilon $ to consume the $\mathtt  {b}$.}}{69}{figure.6.4}\protected@file@percent }
\newlabel{fig:posix-vs-greedy}{{6.4}{69}{The two parse trees for $(a+ab)(b+\varepsilon )$ against \texttt {"ab"}. Both flatten to \texttt {"ab"} and both are valid. The derivative parsers take the second alternative of $a+ab$, consuming both characters at once and leaving $b+\varepsilon $ to match empty; the partial-derivative parsers take the first, leaving $b+\varepsilon $ to consume the $\mathtt {b}$}{figure.6.4}{}}
