\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces The standard partial-derivative parser for $r_0 = (a + ab)(b + \varepsilon )$ and input $\mathtt  {ab}$. Each box shows a state $(r,\iota )$, pairing a residual with its injection. $\mathit  {pderiv}(-,x)$ advances each state by $x$, while $\mathit  {select}$ applies the injection of the first accepting state to $\mathit  {mkEps}$ of its residual.}}{38}{figure.caption.33}\protected@file@percent }
\newlabel{fig:pderiv-std-overview}{{6.1}{38}{The standard partial-derivative parser for $r_0 = (a + ab)(b + \varepsilon )$ and input $\mathtt {ab}$. Each box shows a state $(r,\iota )$, pairing a residual with its injection. $\mathit {pderiv}(-,x)$ advances each state by $x$, while $\mathit {select}$ applies the injection of the first accepting state to $\mathit {mkEps}$ of its residual}{figure.caption.33}{}}
