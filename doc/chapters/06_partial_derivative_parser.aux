\newlabel{sec:partial-derivative-parser-rust}{{6.2.1}{46}{The Driver}{equation.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces The frontier loop and its entry point. \texttt  {step\_frontier} replaces every \texttt  {(residual, bits)} pair with the union of \texttt  {pderiv\_bc} applied to it, concatenating each result's bits onto that strand's accumulated prefix. \texttt  {select\_bits} scans in list order and returns the first nullable strand's \texttt  {bits ++ mk\_eps\_bits(residual)}.}}{47}{figure.caption.27}\protected@file@percent }
\newlabel{fig:pderivbc-driver-rust}{{6.4}{47}{The frontier loop and its entry point. \texttt {step\_frontier} replaces every \texttt {(residual, bits)} pair with the union of \texttt {pderiv\_bc} applied to it, concatenating each result's bits onto that strand's accumulated prefix. \texttt {select\_bits} scans in list order and returns the first nullable strand's \texttt {bits ++ mk\_eps\_bits(residual)}}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6.3}The Standard Construction: \texttt  {pderiv\_std}}{48}{section.6.3}\protected@file@percent }
\newlabel{sec:pderiv-std-theory-rust}{{6.3}{48}{The Standard Construction: \texttt {pderiv\_std}}{section.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces The same frontier as Figure~\ref {fig:frontier}, with each strand's extra payload an injection closure $\iota $ instead of a bit prefix; Figure~\ref {fig:strand-state} shows what one such closure chain is built from. The winning residual at the end is $\varepsilon $, exactly as in Figure~\ref {fig:frontier}, but the intermediate residuals differ: where \texttt  {pderiv\_bc} reaches \texttt  {Alt(Lit('b'), Eps)} after $\mathtt  {a}$, this construction reaches \texttt  {Seq(Eps, Alt(Lit('b'), Eps))}, retaining the $\varepsilon $ node \texttt  {smart\_seq} would collapse. Section~\ref {sec:pderiv-std-theory-rust} explains why.}}{48}{figure.caption.28}\protected@file@percent }
\newlabel{fig:pderiv-std-frontier}{{6.5}{48}{The same frontier as Figure~\ref {fig:frontier}, with each strand's extra payload an injection closure $\iota $ instead of a bit prefix; Figure~\ref {fig:strand-state} shows what one such closure chain is built from. The winning residual at the end is $\varepsilon $, exactly as in Figure~\ref {fig:frontier}, but the intermediate residuals differ: where \texttt {pderiv\_bc} reaches \texttt {Alt(Lit('b'), Eps)} after $\mathtt {a}$, this construction reaches \texttt {Seq(Eps, Alt(Lit('b'), Eps))}, retaining the $\varepsilon $ node \texttt {smart\_seq} would collapse. Section~\ref {sec:pderiv-std-theory-rust} explains why}{figure.caption.28}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3.1}What Each Strand Carries}{48}{subsection.6.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces What one strand holds after two derivative steps, for the winning strand of Figure~\ref {fig:frontier}. The bit-coded strand accumulates into a flat buffer; the tree-building strand accumulates a chain of heap-allocated closures, one link per step, each holding the next. Both are consumed exactly once, on the winning strand, at the end of the input.}}{48}{figure.caption.29}\protected@file@percent }
\newlabel{fig:strand-state}{{6.6}{48}{What one strand holds after two derivative steps, for the winning strand of Figure~\ref {fig:frontier}. The bit-coded strand accumulates into a flat buffer; the tree-building strand accumulates a chain of heap-allocated closures, one link per step, each holding the next. Both are consumed exactly once, on the winning strand, at the end of the input}{figure.caption.29}{}}
\@writefile{toc}{\contentsline {paragraph}{In Rust.}{49}{figure.caption.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces \texttt  {Inj}, its identity value, and \texttt  {nub\_tree}. \texttt  {nub\_tree} is \texttt  {nub2} (Figure~\ref {fig:nub2-rust}) with \texttt  {Vec<bool>} replaced by \texttt  {Inj}; the deduplication logic itself, keep the first strand to reach a given residual, is unchanged.}}{49}{figure.caption.30}\protected@file@percent }
\newlabel{fig:inj-type-rust}{{6.7}{49}{\texttt {Inj}, its identity value, and \texttt {nub\_tree}. \texttt {nub\_tree} is \texttt {nub2} (Figure~\ref {fig:nub2-rust}) with \texttt {Vec<bool>} replaced by \texttt {Inj}; the deduplication logic itself, keep the first strand to reach a given residual, is unchanged}{figure.caption.30}{}}
