\@writefile{lof}{\contentsline {figure}{\numberline {6.8}{\ignorespaces \texttt  {nub2}: stable deduplication on the residual alone. \texttt  {HashSet::insert} returns \texttt  {true} the first time a value is seen and \texttt  {false} on every repeat, so the loop keeps a pair exactly when its residual has not been seen before, in the order the input \texttt  {Vec} presents them.}}{59}{figure.caption.39}\protected@file@percent }
\newlabel{fig:nub2-rust}{{6.8}{59}{\texttt {nub2}: stable deduplication on the residual alone. \texttt {HashSet::insert} returns \texttt {true} the first time a value is seen and \texttt {false} on every repeat, so the loop keeps a pair exactly when its residual has not been seen before, in the order the input \texttt {Vec} presents them}{figure.caption.39}{}}
