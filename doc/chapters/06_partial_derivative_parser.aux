\@writefile{toc}{\contentsline {subsection}{\numberline {6.1.2}State Sets and Selection}{49}{subsection.6.1.2}\protected@file@percent }
\newlabel{sec:pderiv-state-set}{{6.1.2}{49}{State Sets and Selection}{subsection.6.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces \texttt  {step\_frontier}: one transition of the NFA state set on a single character. The function name retains the older ``frontier'' terminology; it computes the successor state set $\delta (S, x)$. The final \texttt  {nub\_tree} deduplicates \emph  {across} parent configurations, not just within one parent's own expansion (which \texttt  {pderiv\_tree} already does on its own output) -- without it, two strands that independently derive to the same residual both survive, and the state set can double every character on an ambiguous pattern even though the number of distinct residuals stays bounded by the pattern's own size.}}{50}{figure.caption.30}\protected@file@percent }
\newlabel{fig:step-frontier-rust}{{6.3}{50}{\texttt {step\_frontier}: one transition of the NFA state set on a single character. The function name retains the older ``frontier'' terminology; it computes the successor state set $\delta (S, x)$. The final \texttt {nub\_tree} deduplicates \emph {across} parent configurations, not just within one parent's own expansion (which \texttt {pderiv\_tree} already does on its own output) -- without it, two strands that independently derive to the same residual both survive, and the state set can double every character on an ambiguous pattern even though the number of distinct residuals stays bounded by the pattern's own size}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces \texttt  {select}: return the tree for the first accepting configuration in the state set. \texttt  {reverse\_stars} undoes, in one O(total output size) pass, the left-to-right-via-push construction order \texttt  {pderiv\_tree}'s \texttt  {Star} arm uses (Figure~\ref {fig:pderiv-tree-rust}).}}{50}{figure.caption.31}\protected@file@percent }
\newlabel{fig:select-rust}{{6.4}{50}{\texttt {select}: return the tree for the first accepting configuration in the state set. \texttt {reverse\_stars} undoes, in one O(total output size) pass, the left-to-right-via-push construction order \texttt {pderiv\_tree}'s \texttt {Star} arm uses (Figure~\ref {fig:pderiv-tree-rust})}{figure.caption.31}{}}
