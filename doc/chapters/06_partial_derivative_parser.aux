\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces The standard partial-derivative parser on $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt  {ab}$. Each box is a state $(r, \iota )$: a residual and an injection. $\mathit  {pderiv}(-,x)$ advances every state by one character; $\mathit  {select}$ takes the first accepting state and applies its injection to $\mathit  {mkEps}$ of its residual.}}{46}{figure.caption.27}\protected@file@percent }
\newlabel{fig:pderiv-std-overview}{{6.1}{46}{The standard partial-derivative parser on $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt {ab}$. Each box is a state $(r, \iota )$: a residual and an injection. $\mathit {pderiv}(-,x)$ advances every state by one character; $\mathit {select}$ takes the first accepting state and applies its injection to $\mathit {mkEps}$ of its residual}{figure.caption.27}{}}
