\newlabel{sec:frontier-growth}{{6.4}{54}{Frontier Growth}{section.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.11}{\ignorespaces Frontier size against distinct residual count for $(a+(b+ab))^{*}$ on $(\mathtt  {ab})^{n}$, logarithmic vertical scale. The frontier doubles every two characters while the number of distinct residuals never exceeds two: every strand beyond the second is a duplicate carrying different accumulated state. Regenerate with \texttt  {cargo run -{}-release -{}-example thesis\_figures -{}- frontier}; \texttt  {tests/test\_thesis\_figures.rs} pins these values.}}{55}{figure.caption.34}\protected@file@percent }
\newlabel{fig:frontier-growth}{{6.11}{55}{Frontier size against distinct residual count for $(a+(b+ab))^{*}$ on $(\mathtt {ab})^{n}$, logarithmic vertical scale. The frontier doubles every two characters while the number of distinct residuals never exceeds two: every strand beyond the second is a duplicate carrying different accumulated state. Regenerate with \texttt {cargo run -{}-release -{}-example thesis\_figures -{}- frontier}; \texttt {tests/test\_thesis\_figures.rs} pins these values}{figure.caption.34}{}}
