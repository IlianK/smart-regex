\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces \texttt  {pderiv\_tree}: one partial-derivative transition, producing a list of (residual, injection-step) states.}}{48}{figure.caption.29}\protected@file@percent }
