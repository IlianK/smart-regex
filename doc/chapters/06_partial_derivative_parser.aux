\@writefile{lof}{\contentsline {figure}{\numberline {6.12}{\ignorespaces The two parse trees for $(a+ab)(b+\varepsilon )$ against \texttt  {"ab"}. Both flatten to \texttt  {"ab"} and both are valid. The derivative parsers take the second alternative of $a+ab$, consuming both characters at once and leaving $b+\varepsilon $ to match empty; the partial-derivative parsers take the first, leaving $b+\varepsilon $ to consume the $\mathtt  {b}$.}}{68}{figure.caption.43}\protected@file@percent }
\newlabel{fig:posix-vs-greedy}{{6.12}{68}{The two parse trees for $(a+ab)(b+\varepsilon )$ against \texttt {"ab"}. Both flatten to \texttt {"ab"} and both are valid. The derivative parsers take the second alternative of $a+ab$, consuming both characters at once and leaving $b+\varepsilon $ to match empty; the partial-derivative parsers take the first, leaving $b+\varepsilon $ to consume the $\mathtt {b}$}{figure.caption.43}{}}
