\newlabel{sec:pderiv-bc}{{6.2}{54}{The Bit-Coded Partial-Derivative Parser}{section.6.2}{}}
\newlabel{eq:pderiv-bc-overview}{{6.5}{54}{The Bit-Coded Partial-Derivative Parser}{equation.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt  {ab}$. Each box is a pair: a residual expression and a bit-sequence, with $0$ marking a left branch or one more iteration and $1$ marking a right branch or termination. Selection takes the first accepting pair in $S_2$ and appends $\mathit  {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit  {decode}_{r_0}$ reads against the original expression.}}{54}{figure.caption.43}\protected@file@percent }
\newlabel{fig:pderiv-bc-overview}{{6.7}{54}{Overview of the bit-coded partial-derivative parser on the ambiguous example $r_0 = (a + ab)(b + \varepsilon )$ with input $\mathtt {ab}$. Each box is a pair: a residual expression and a bit-sequence, with $0$ marking a left branch or one more iteration and $1$ marking a right branch or termination. Selection takes the first accepting pair in $S_2$ and appends $\mathit {mkEpsBC}$ of its residual, yielding the bit-string $[0,0]$, which $\mathit {decode}_{r_0}$ reads against the original expression}{figure.caption.43}{}}
