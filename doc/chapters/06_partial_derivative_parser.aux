\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces The frontier for $r_0 = (a+ab)(b+\varepsilon )$ against \texttt  {"ab"}, with \texttt  {pderiv\_bc}'s bits as the per-strand extra and the rule producing each strand on its arrow. One character advances every strand independently. At the end \emph  {both} strands are nullable, and selection takes the first in list order without comparing them, which is where the construction settles on one tree and not the other.}}{49}{figure.caption.32}\protected@file@percent }
\newlabel{fig:frontier}{{6.1}{49}{The frontier for $r_0 = (a+ab)(b+\varepsilon )$ against \texttt {"ab"}, with \texttt {pderiv\_bc}'s bits as the per-strand extra and the rule producing each strand on its arrow. One character advances every strand independently. At the end \emph {both} strands are nullable, and selection takes the first in list order without comparing them, which is where the construction settles on one tree and not the other}{figure.caption.32}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6.2}The Standard Partial-Derivative-Based Parser}{49}{section.6.2}\protected@file@percent }
\newlabel{sec:pderiv-std-theory-rust}{{6.2}{49}{The Standard Partial-Derivative-Based Parser}{section.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces The same frontier as Figure~\ref {fig:frontier}, with each strand's extra payload an injection closure $\iota $ instead of a bit prefix; Figure~\ref {fig:strand-state} shows what one such closure chain is built from. The winning residual at the end is $\varepsilon $, exactly as in Figure~\ref {fig:frontier}, but the intermediate residuals differ: where \texttt  {pderiv\_bc} reaches \texttt  {Alt(Lit('b'), Eps)} after $\mathtt  {a}$, this construction reaches \texttt  {Seq(Eps, Alt(Lit('b'), Eps))}, retaining the $\varepsilon $ node \texttt  {smart\_seq} would collapse. This section explains why.}}{49}{figure.caption.33}\protected@file@percent }
\newlabel{fig:pderiv-std-frontier}{{6.2}{49}{The same frontier as Figure~\ref {fig:frontier}, with each strand's extra payload an injection closure $\iota $ instead of a bit prefix; Figure~\ref {fig:strand-state} shows what one such closure chain is built from. The winning residual at the end is $\varepsilon $, exactly as in Figure~\ref {fig:frontier}, but the intermediate residuals differ: where \texttt {pderiv\_bc} reaches \texttt {Alt(Lit('b'), Eps)} after $\mathtt {a}$, this construction reaches \texttt {Seq(Eps, Alt(Lit('b'), Eps))}, retaining the $\varepsilon $ node \texttt {smart\_seq} would collapse. This section explains why}{figure.caption.33}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2.1}What Each Strand Carries}{50}{subsection.6.2.1}\protected@file@percent }
\newlabel{sec:pderiv-std-strand-theory}{{6.2.1}{50}{What Each Strand Carries}{subsection.6.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces What one strand holds after two derivative steps, for the winning strand of Figure~\ref {fig:frontier}. The bit-coded strand accumulates into a flat buffer; the tree-building strand accumulates a chain of heap-allocated closures, one link per step, each holding the next. Both are consumed exactly once, on the winning strand, at the end of the input.}}{50}{figure.caption.34}\protected@file@percent }
\newlabel{fig:strand-state}{{6.3}{50}{What one strand holds after two derivative steps, for the winning strand of Figure~\ref {fig:frontier}. The bit-coded strand accumulates into a flat buffer; the tree-building strand accumulates a chain of heap-allocated closures, one link per step, each holding the next. Both are consumed exactly once, on the winning strand, at the end of the input}{figure.caption.34}{}}
