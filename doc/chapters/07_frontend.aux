\newlabel{sec:frontend-parsing}{{7.2}{59}{Parsing Surface Syntax}{section.7.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.3}Translating \texttt  {ExtPat} into \texttt  {Regex}}{60}{section.7.3}\protected@file@percent }
\newlabel{sec:frontend-translate}{{7.3}{60}{Translating \texttt {ExtPat} into \texttt {Regex}}{section.7.3}{}}
\citation{sulzmannlu2014}
\@writefile{toc}{\contentsline {paragraph}{Character classes are represented by alternation.}{61}{section.7.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Bounds are desugared by explicit repetition.}{61}{section.7.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Greedy and lazy quantifiers are parsed but not distinguished.}{61}{section.7.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7.4}Anchors and the Two Entry Points}{61}{section.7.4}\protected@file@percent }
\newlabel{sec:frontend-anchors}{{7.4}{61}{Anchors and the Two Entry Points}{section.7.4}{}}
\@writefile{toc}{\contentsline {paragraph}{\texttt  {\^{}}, \texttt  {\$}, and \texttt  {\textbackslash {}b}/\texttt  {\textbackslash {}B} are rejected at the same site, for the same reason.}{62}{section.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces The two rejecting arms of \texttt  {translate}. Unlike backreferences and lookaround (Section~\ref {sec:frontend-parsing}), which have no \texttt  {ExtPat} constructor and are rejected while parsing, these four constructs parse successfully into \texttt  {ExtPat::Carat}, \texttt  {ExtPat::Dollar}, and \texttt  {ExtPat::WordBoundary} and are rejected one stage later, during translation.}}{62}{figure.caption.38}\protected@file@percent }
\newlabel{fig:anchor-rejection-rust}{{7.1}{62}{The two rejecting arms of \texttt {translate}. Unlike backreferences and lookaround (Section~\ref {sec:frontend-parsing}), which have no \texttt {ExtPat} constructor and are rejected while parsing, these four constructs parse successfully into \texttt {ExtPat::Carat}, \texttt {ExtPat::Dollar}, and \texttt {ExtPat::WordBoundary} and are rejected one stage later, during translation}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {paragraph}{Rejection is total, not local.}{62}{figure.caption.38}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Three of \texttt  {translate}'s recursive arms. Every other compound arm (\texttt  {Concat}, \texttt  {Opt}, \texttt  {Plus}, \texttt  {Bound}) follows the same \texttt  {?}-propagation shape.}}{63}{figure.caption.39}\protected@file@percent }
\newlabel{fig:anchor-propagation-rust}{{7.2}{63}{Three of \texttt {translate}'s recursive arms. Every other compound arm (\texttt {Concat}, \texttt {Opt}, \texttt {Plus}, \texttt {Bound}) follows the same \texttt {?}-propagation shape}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Every placement is rejected identically, including the three where the anchor is reachable only through an optional, alternative, or bounded branch that need not be taken at all. \texttt  {translate} never gets the chance to discover that: structural recursion visits the anchor node regardless of what quantifier or alternation surrounds it, and Figure~\ref {fig:anchor-propagation-rust}'s \texttt  {?} chain reports it immediately.}}{63}{figure.caption.40}\protected@file@percent }
\newlabel{fig:anchor-rejection-cli}{{7.3}{63}{Every placement is rejected identically, including the three where the anchor is reachable only through an optional, alternative, or bounded branch that need not be taken at all. \texttt {translate} never gets the chance to discover that: structural recursion visits the anchor node regardless of what quantifier or alternation surrounds it, and Figure~\ref {fig:anchor-propagation-rust}'s \texttt {?} chain reports it immediately}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {paragraph}{\texttt  {parse\_pcre\_rule} additionally unwraps PCRE delimiters, case-folds on \texttt  {i}, and rejects two more flags outright.}{63}{figure.caption.40}\protected@file@percent }
