\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Lowered node counts, logarithmic horizontal axis. The three smallest are plain structural desugarings, with no character class involved. Every entry from \texttt  {\textbackslash d} upward expands one, and the two \texttt  {search} entries additionally carry the padding of Figure~\ref {fig:padding}. A realistic corpus pattern therefore starts around 450 nodes before any input is read. Regenerate with \texttt  {cargo run -{}-release -{}-example thesis\_figures -{}- lowered}.}}{64}{figure.caption.38}\protected@file@percent }
\newlabel{fig:lowered-size}{{7.3}{64}{Lowered node counts, logarithmic horizontal axis. The three smallest are plain structural desugarings, with no character class involved. Every entry from \texttt {\textbackslash d} upward expands one, and the two \texttt {search} entries additionally carry the padding of Figure~\ref {fig:padding}. A realistic corpus pattern therefore starts around 450 nodes before any input is read. Regenerate with \texttt {cargo run -{}-release -{}-example thesis\_figures -{}- lowered}}{figure.caption.38}{}}
