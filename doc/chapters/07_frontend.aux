\newlabel{sec:frontend}{{7}{58}{External To Internal Regex}{chapter.7}{}}
\@writefile{toc}{\contentsline {paragraph}{This frontend accepts a strict subset of PCRE syntax.}{58}{chapter.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7.1}Two ASTs}{59}{section.7.1}\protected@file@percent }
\newlabel{sec:frontend-two-asts}{{7.1}{59}{Two ASTs}{section.7.1}{}}
