\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Anchor-aware padding under the search entry points. Each $\Sigma ^{*}$ is one \texttt  {wildcard\_run()}, 196 nodes on its own, so the padding dominates the lowered expression whenever the pattern is short. The fully anchored case still costs 9 rather than 5 nodes, because the erased \texttt  {\^{}} and \texttt  {\$} leave an \texttt  {Eps} apiece behind in the concatenation.}}{70}{figure.7.3}\protected@file@percent }
\newlabel{fig:padding}{{7.3}{70}{Anchor-aware padding under the search entry points. Each $\Sigma ^{*}$ is one \texttt {wildcard\_run()}, 196 nodes on its own, so the padding dominates the lowered expression whenever the pattern is short. The fully anchored case still costs 9 rather than 5 nodes, because the erased \texttt {\^{}} and \texttt {\$} leave an \texttt {Eps} apiece behind in the concatenation}{figure.7.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Edge case.}{70}{figure.7.3}\protected@file@percent }
