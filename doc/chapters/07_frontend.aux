\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces The frontend as a pipeline. The solid path is common to all three entry points; the dashed stages apply only where marked. \texttt  {parse\_pattern} stops at \texttt  {Regex} and means full-string equality, while \texttt  {parse\_dataset\_pattern} and \texttt  {parse\_pcre\_rule} continue into the padding of Section~\ref {sec:frontend-substring-search}.}}{65}{figure.7.1}\protected@file@percent }
\newlabel{fig:frontend-pipeline}{{7.1}{65}{The frontend as a pipeline. The solid path is common to all three entry points; the dashed stages apply only where marked. \texttt {parse\_pattern} stops at \texttt {Regex} and means full-string equality, while \texttt {parse\_dataset\_pattern} and \texttt {parse\_pcre\_rule} continue into the padding of Section~\ref {sec:frontend-substring-search}}{figure.7.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.2}Parsing Surface Syntax}{65}{section.7.2}\protected@file@percent }
\newlabel{sec:frontend-parsing}{{7.2}{65}{Parsing Surface Syntax}{section.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces The recursive-descent ladder of \texttt  {frontend/parse.rs}. Each production strips one layer and delegates the rest downward, so precedence falls out of the call order. \texttt  {parse\_group} is the only production that climbs back to the top, which is why parentheses override precedence and why nesting is unbounded.}}{66}{figure.7.2}\protected@file@percent }
\newlabel{fig:precedence-ladder}{{7.2}{66}{The recursive-descent ladder of \texttt {frontend/parse.rs}. Each production strips one layer and delegates the rest downward, so precedence falls out of the call order. \texttt {parse\_group} is the only production that climbs back to the top, which is why parentheses override precedence and why nesting is unbounded}{figure.7.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Bounds are parsed speculatively.}{67}{figure.7.2}\protected@file@percent }
