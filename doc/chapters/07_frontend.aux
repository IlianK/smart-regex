\@writefile{toc}{\contentsline {section}{\numberline {7.1}Two ASTs, One Lowering Step}{58}{section.7.1}\protected@file@percent }
\newlabel{sec:frontend-two-asts}{{7.1}{58}{Two ASTs, One Lowering Step}{section.7.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces The frontend as a pipeline. The solid path is common to all three entry points; the dashed stages apply only where marked. \texttt  {parse\_pattern} stops at \texttt  {Regex} and means full-string equality, while \texttt  {parse\_dataset\_pattern} and \texttt  {parse\_pcre\_rule} continue into the padding of Section~\ref {sec:frontend-substring-search}.}}{59}{figure.caption.36}\protected@file@percent }
\newlabel{fig:frontend-pipeline}{{7.1}{59}{The frontend as a pipeline. The solid path is common to all three entry points; the dashed stages apply only where marked. \texttt {parse\_pattern} stops at \texttt {Regex} and means full-string equality, while \texttt {parse\_dataset\_pattern} and \texttt {parse\_pcre\_rule} continue into the padding of Section~\ref {sec:frontend-substring-search}}{figure.caption.36}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.2}Parsing Surface Syntax}{59}{section.7.2}\protected@file@percent }
\newlabel{sec:frontend-parsing}{{7.2}{59}{Parsing Surface Syntax}{section.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces The recursive-descent ladder of \texttt  {frontend/parse.rs}. Each production strips one layer and delegates the rest downward, so precedence falls out of the call order. \texttt  {parse\_group} is the only production that climbs back to the top, which is why parentheses override precedence and why nesting is unbounded.}}{60}{figure.caption.37}\protected@file@percent }
\newlabel{fig:precedence-ladder}{{7.2}{60}{The recursive-descent ladder of \texttt {frontend/parse.rs}. Each production strips one layer and delegates the rest downward, so precedence falls out of the call order. \texttt {parse\_group} is the only production that climbs back to the top, which is why parentheses override precedence and why nesting is unbounded}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {paragraph}{Bounds are parsed speculatively.}{61}{figure.caption.37}\protected@file@percent }
