{
  "meta": {
    "purpose": "Stress-test patterns for the derivative-based matcher (Brzozowski/Antimirov, deriv_std/pderiv engines). 'Pathological' here means derivative-state explosion or polynomial/compile blow-up under this engine family, not backtracking blowup -- catastrophic backtracking does not apply.",
    "engine_notes": "All patterns verified against the real src/frontend/{parse,translate,alphabet}.rs on the benches branch: anchors, \\b/\\B, backreferences, lookaround and POSIX classes all hard-reject at parse/translate time, so none appear below. Every pattern is full-string-match only.",
    "max_bound": 1000,
    "max_bound_policy": "Kept as-is -- this is a frontend input-validation cap (translate() hard-errors above it), not an engine limit worth loosening. Raising it would only test parse-time allocation, not matcher behavior. Compile/translate blow-up (categories C/D/J) is stressed instead by NESTING bounded repeats so the unrolled tree size multiplies while every individual bound stays <= 1000 (see E40's notes for a concrete worked example)."
  },
  "macros": {
    "{N}": "input-length sweep parameter; a harness substitutes one value from the row's (or category's) suggested_n per run",
    "{P}": "pattern-size parameter for J/K rows; expand via each row's `generator` before parsing -- not a numeric substitution into existing regex text",
    "WORD_i": "deterministic word generator for {P}-rows: word i is `f'w{i:06d}'` (e.g. w000001, w000002, ...)"
  },
  "categories": {
    "A": {
      "name": "Nested quantifiers",
      "mechanism": "Quantified group inside another quantifier (+, *, {1,})",
      "stress_axis": "derivative-state explosion",
      "suggested_n": [
        20,
        50,
        100,
        200
      ]
    },
    "B": {
      "name": "Overlapping alternation",
      "mechanism": "Alternatives matching the same prefix under a quantifier",
      "stress_axis": "derivative-state explosion",
      "suggested_n": [
        20,
        50,
        100,
        200
      ]
    },
    "C": {
      "name": "Bounded rep over star",
      "mechanism": "{m,n} wrapping a */+ body; unrolled at translate time",
      "stress_axis": "compile blow-up (unrolled) + polynomial match",
      "suggested_n": [
        100,
        500,
        1000,
        5000
      ]
    },
    "D": {
      "name": "Anchored-failure style",
      "mechanism": "Must fully consume input; near-miss tail forces full enumeration",
      "stress_axis": "compile blow-up (unrolled) + derivative-state explosion",
      "suggested_n": [
        40,
        60,
        100
      ]
    },
    "E": {
      "name": "Prefix-overlap alternation",
      "mechanism": "One alternative is a strict prefix of another",
      "stress_axis": "derivative-state explosion",
      "suggested_n": [
        20,
        50,
        100,
        200
      ]
    },
    "F": {
      "name": "Alternation-star + literal",
      "mechanism": "(alt)* or (alt)+ then a literal that fails late",
      "stress_axis": "polynomial (simple alt) or derivative-state explosion (nested)",
      "suggested_n": [
        100,
        500,
        1000
      ]
    },
    "H": {
      "name": "Many adjacent stars/groups",
      "mechanism": "Product of .+, .*, \\w+ etc. in sequence",
      "stress_axis": "polynomial O(N^k), k = number of stars",
      "suggested_n": [
        10,
        20,
        50,
        100,
        500,
        1500
      ]
    },
    "I": {
      "name": "Trivial pattern, large input",
      "mechanism": "Simple pattern on a very long input",
      "stress_axis": "linear throughput / constant-factor",
      "suggested_n": [
        100000,
